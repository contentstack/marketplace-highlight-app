{
    "name": "@contentstack/marketplace-highlight-app",
    "version": "1.0.2",
    "description": "Highlight Plugin for Contentstack JSON Rich Text Editor",
    "entry": "plugin",
    "output": "highlight.js",
    "main": "dist/highlight.js",
    "typings": "dist/types/highlight.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "webpack --config webpack.prod.js",
        "start": "webpack serve --config webpack.dev.js",
        "dev": "webpack --config webpack.dev.js",
        "lint": "tslint -p tsconfig.json -c tslint.json",
        "lint:fix": "tslint -p tsconfig.json -c tslint.json --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "author": "Contentstack",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/contentstack/marketplace-highlight-app.git"
    },
    "devDependencies": {
        "@playwright/test": "^1.55.0",
        "@types/node": "^18.19.130",
        "@types/react": "^16.9.11",
        "@types/react-dom": "^16.9.25",
        "@vitest/coverage-v8": "^3.2.4",
        "css-loader": "^6.5.1",
        "jsdom": "^24.1.3",
        "playwright": "^1.55.0",
        "prettier": "^3.6.2",
        "style-loader": "^1.2.1",
        "ts-loader": "^9.2.6",
        "tslint": "^5.11.0",
        "tslint-config-prettier": "^1.15.0",
        "tslint-config-standard": "^8.0.1",
        "typescript": "^4.7.4",
        "vitest": "^3.2.4",
        "webpack": "^5.65.0",
        "webpack-cli": "^4.9.1",
        "webpack-dev-server": "^5.2.3",
        "webpack-merge": "^5.8.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "dependencies": {
        "@contentstack/app-sdk": "^2.3.3",
        "dotenv": "^17.2.3",
        "react": "^16.11.0",
        "react-dom": "^16.13.1"
    },
    "keywords": [
        "rte",
        "plugin",
        "highlight"
    ]
}
